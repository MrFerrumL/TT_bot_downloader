# 1. Create a bot with @BotFather and paste the token here.
BOT_TOKEN=PASTE_A_NEW_TOKEN_FROM_BOTFATHER_HERE

# Telegram Bot API commonly rejects large direct uploads. Keep this near 49 MB
# unless you run your own local Bot API server with higher limits.
MAX_UPLOAD_MB=49

# Folder where videos are downloaded.
DOWNLOAD_DIR=downloads

# Allowed values: 5 or 10. Users can change this in the bot too.
DEFAULT_VIDEO_COUNT=5

# Quality presets: low, medium, high.
DEFAULT_QUALITY=medium

# true = remove downloaded files after sending, false = keep them on disk.
CLEANUP_AFTER_SEND=true

# Optional: path to a cookies.txt file for accounts/content you are allowed to access.
# Example: C:\Users\you\Documents\cookies.txt
YTDLP_COOKIES_FILE=

# Optional: use cookies from a browser where you are already logged in.
# For private content, use only an account that is allowed to view it.
# Examples: chrome, edge, firefox, brave, or chrome:Default
YTDLP_COOKIES_FROM_BROWSER=

# Optional lawful processing for videos you own or are allowed to modify.
# This is branding/compression, not copyright-block evasion.
PROCESS_OWN_VIDEOS=false
WATERMARK_TEXT=

# Optional: proxy for the Telegram Bot API when your network cannot reach
# api.telegram.org directly. Examples: socks5://127.0.0.1:1080 or http://127.0.0.1:8080
TELEGRAM_PROXY=
